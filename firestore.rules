rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSeason(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 250 &&
             data.poolLength in ['25m', '50m', '25y'] &&
             data.lanes is list &&
             data.weeks is list;
    }

    function isValidDrill(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.category is string && data.category.size() <= 50 &&
             data.focus is string && data.focus.size() <= 100;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'swimmer'];
    }

    function isValidSavedWorkout(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.blocks is list;
    }

    // Squad seasons and workouts collection
    match /seasons/{seasonId} {
      allow get, list: if true;
      allow create, update: if isValidId(seasonId) && isValidSeason(request.resource.data);
      allow delete: if isValidId(seasonId);
    }

    // Squad drill library collection
    match /drills/{drillId} {
      allow get, list: if true;
      allow create, update: if isValidId(drillId) && isValidDrill(request.resource.data);
      allow delete: if isValidId(drillId);
    }

    // Squad user profiles collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Squad saved workouts collection
    match /saved_workouts/{workoutId} {
      allow get, list: if true;
      allow create, update: if isValidId(workoutId) && isValidSavedWorkout(request.resource.data);
      allow delete: if isValidId(workoutId);
    }

    // Squad season backups collection
    match /season_backups/{backupId} {
      allow get, list: if true;
      allow create, update: if isValidId(backupId) && isValidSeason(request.resource.data);
      allow delete: if isValidId(backupId);
    }
  }
}
